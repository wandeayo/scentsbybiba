---
import type { Perfume } from '../lib/data';
import { priceLabel, orderMessage } from '../lib/data';
import { bottleSvg } from '../lib/bottle';
import { waLink } from '../lib/site';
interface Props { p: Perfume; headingLevel?: 'h2' | 'h3'; city?: string }
const { p, headingLevel = 'h3', city } = Astro.props;
const H = headingLevel;
const band = p.price < 20000 ? 'u20' : p.price <= 35000 ? '20to35' : p.price <= 60000 ? '35to60' : 'o60';
const kind = /Mini|mist|spray|Oil/i.test(p.type) ? 'small' : /Designer|Niche|High street/.test(p.type) ? 'designer' : 'bottle';
const tag = p.availability === 'in-store' ? 'In the boutique' : p.availability === 'order-in' ? 'Order-in' : '';
const href = `/p/${p.slug}/`;
---
<article class="tile" data-g={p.gender} data-f={p.group} data-band={band} data-a={p.availability} data-kind={kind} data-price={p.price}>
  <a class={`tile-art glow-${p.group}`} href={href} tabindex="-1" aria-hidden="true">
    {tag && <span class="tile-tag">{tag}</span>}
    {p.photo
      ? <img class={p.photoCutout ? 'cutout' : 'scene'} src={p.photo} alt="" loading="lazy" decoding="async" />
      : <Fragment set:html={bottleSvg(p.slug, p.type, p.group, p.gender)} />}
  </a>
  <div class="tile-body">
    <H><a href={href}>{p.name}</a></H>
    {p.brand && <p class="tile-brand">{p.brand}</p>}
    <p class="tile-family">{p.family.split(' · ').slice(0, 2).join(' & ').toLowerCase()}</p>
    <p class="price">{priceLabel(p)}</p>
    <a class="tile-order" href={waLink(orderMessage(p, undefined, city))} target="_blank" rel="noopener" data-wa="tile" data-perfume={p.name}>Order on WhatsApp</a>
  </div>
</article>
