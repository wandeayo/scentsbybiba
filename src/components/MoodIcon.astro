---
// Drawn emblems for the scent moods, in one gold line weight.
interface Props { mood: string }
const { mood } = Astro.props;
---
<svg class="mood-icon" viewBox="0 0 96 96" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {mood === 'fresh' && (
    <g>
      <circle cx="48" cy="48" r="30" />
      <circle cx="48" cy="48" r="25" />
      {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
        <path d={`M48 48 L${48 + 22 * Math.cos((a * Math.PI) / 180)} ${48 + 22 * Math.sin((a * Math.PI) / 180)}`} />
      ))}
      <path d="M66 16c6-6 14-6 18-2-4 4-12 6-18 2z" />
      <path d="M62 22l4-6" />
    </g>
  )}
  {mood === 'sweet' && (
    <g>
      <path d="M30 80C42 62 52 40 70 14" />
      <path d="M34 82C46 64 56 42 74 16" />
      <path d="M44 60c-10-2-16 4-18 12 8 2 16-2 18-12z" />
      <path d="M50 48c-4-8-12-10-18-6 4 6 12 10 18 6z" />
      <circle cx="64" cy="38" r="3" />
      <path d="M64 30c-6-8-4-16 0-18 4 2 6 10 0 18zM72 38c8-6 16-4 18 0-2 4-10 6-18 0zM64 46c6 8 4 16 0 18-4-2-6-10 0-18zM56 38c-8 6-16 4-18 0 2-4 10-6 18 0z" />
    </g>
  )}
  {mood === 'floral' && (
    <g>
      <path d="M48 40c4-4 10-2 10 4s-6 10-12 8-8-10-2-16 18-6 20 4-4 18-14 18-18-8-16-18" />
      <path d="M34 34c-6 6-8 18 0 26s22 8 28 0" />
      <path d="M48 62v24" />
      <path d="M48 74c-8-2-14-8-14-14 8 0 14 6 14 14zM48 70c6-4 14-6 18-2-4 6-12 6-18 2z" />
    </g>
  )}
  {mood === 'fruity' && (
    <g>
      <circle cx="34" cy="66" r="13" />
      <circle cx="62" cy="70" r="13" />
      <path d="M36 53c4-16 14-28 26-34M60 57c-2-14 0-28 2-38" />
      <path d="M62 19c8-6 18-4 22 2-8 6-18 6-22-2z" />
      <path d="M30 62c2-3 5-4 8-3" />
    </g>
  )}
  {mood === 'woody' && (
    <g>
      <path d="M18 66l52-36 6 8-52 36z" />
      <path d="M24 74l52-36" />
      <path d="M26 54l50-30 5 8-50 30z" />
      <path d="M31 50c3 3 3 7 0 9M71 24c3 3 3 7 0 9" />
      <path d="M58 70c6 2 12 8 12 14-8 0-12-6-12-14zM70 64c6-2 14 0 16 6-8 2-14 0-16-6z" />
    </g>
  )}
  {mood === 'oud' && (
    <g>
      <path d="M22 78l14-10 16 6 12-8 12 10-14 8-16-4-14 6z" />
      <path d="M36 68l2 8M52 74l-2 8M64 66l2 10" />
      <path d="M48 62c-8-8 6-12-2-20s6-12 0-20" />
      <path d="M58 58c-6-6 4-10-2-16s4-10 0-14" />
      <path d="M38 60c-4-4 2-8-2-12" />
    </g>
  )}
  {mood === 'musky' && (
    <g>
      <path d="M48 38c-6-12 10-18 14-8 10-6 20 4 12 12 10 6 2 20-8 14-2 10-18 10-18 0-10 4-18-8-10-14-8-6 0-20 10-14z" />
      <path d="M48 62v24M48 74c-6-2-12-6-14-12M48 70c6-2 12-6 14-12" />
    </g>
  )}
</svg>
