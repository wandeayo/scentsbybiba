---
// The order bag: buyers collect several perfumes, then send the whole list to Biba
// in one WhatsApp message. There is no checkout or payment here on purpose: Biba
// confirms stock, the final total and delivery in the chat, the way she sells today.
import { SITE } from '../lib/site';
import WaIcon from './WaIcon.astro';
const cities = ['Jos (pick up at the shop)', 'Jos (deliver to me)', 'Abuja', 'Kaduna', 'Kano', 'Lagos', 'Port Harcourt', 'Enugu', 'Bauchi', 'Ibadan'];
---
<dialog id="bag" class="bag" aria-labelledby="bag-title" data-wa={SITE.whatsapp}>
  <div class="bag-inner">
    <header class="bag-head">
      <h2 id="bag-title">Your order</h2>
      <button type="button" class="bag-close" data-bag-close aria-label="Close your order">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <div class="bag-empty" data-bag-empty>
      <p>Your bag is empty.</p>
      <p class="bag-quiet">Add perfumes as you browse, then send the list to Biba in one WhatsApp message.</p>
      <a class="btn btn-line" href="/shop/">Browse the collection</a>
    </div>

    <div class="bag-full" data-bag-full hidden>
      <ul class="bag-list" data-bag-list></ul>

      <div class="bag-summary">
        <p class="bag-total"><span>Estimated total</span><strong data-bag-total></strong></p>
        <p class="bag-quiet bag-small" data-bag-note></p>
        <label class="bag-city">
          <span>Deliver to <span class="bag-quiet">(optional)</span></span>
          <input type="text" list="bag-cities" data-bag-city autocomplete="address-level2" placeholder="Your city or area" />
          <datalist id="bag-cities">{cities.map((c) => <option value={c} />)}</datalist>
        </label>
        <a class="btn btn-noir bag-send" data-bag-send data-wa="bag" href="#" target="_blank" rel="noopener"><WaIcon />Send order to Biba on WhatsApp</a>
        <p class="bag-quiet bag-small">Nothing is charged here. Biba replies to confirm stock, the final total and delivery before you pay.</p>
        <p class="bag-after" data-bag-after hidden>Sent it? <button type="button" class="bag-link" data-bag-clear>Clear the bag</button></p>
      </div>
    </div>
  </div>
</dialog>

<div class="bag-toast" role="status" aria-live="polite" data-bag-toast hidden>
  <span data-bag-toast-text></span>
  <button type="button" class="bag-link" data-bag-open>View bag</button>
</div>

<script>
  type Availability = 'in-store' | 'sold-before' | 'order-in';
  // sq: what the buyer typed in the search when they added it, if they came from a search
  interface Item { s: string; n: string; b: string; z: string; r: string; p: number; a: Availability; q: number; sq?: string }
  interface Saved { items: Item[]; city: string }

  const KEY = 'biba-bag-v1';
  const dialog = document.getElementById('bag') as HTMLDialogElement;
  const wa = dialog.dataset.wa!;
  const $ = <T extends Element>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T;
  const list = $('[data-bag-list]', dialog) as HTMLUListElement;
  const city = $('[data-bag-city]', dialog) as HTMLInputElement;
  const send = $('[data-bag-send]', dialog) as HTMLAnchorElement;
  const toast = $('[data-bag-toast]') as HTMLElement;
  let toastTimer = 0;

  // Browser storage can be missing or blocked (private mode, some in-app browsers),
  // so the bag still works for the visit without it.
  let memory: Saved = { items: [], city: '' };
  function load(): Saved {
    try { const raw = localStorage.getItem(KEY); if (raw) memory = JSON.parse(raw); } catch {}
    return memory;
  }
  function save(next: Saved) {
    memory = next;
    try { localStorage.setItem(KEY, JSON.stringify(next)); } catch {}
    render();
  }

  const naira = (n: number) => '₦' + n.toLocaleString('en-NG');
  const size = (z: string) => (z && /^\d+$/.test(z) ? `${z}ml` : z);
  const priceText = (i: Item) => (i.a === 'order-in' ? `About ${naira(i.p)}` : naira(i.p));
  const tag = { 'in-store': 'In the boutique', 'sold-before': 'Check restock', 'order-in': 'Order-in' } as const;
  const esc = (t: string) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const track = (name: string, data?: Record<string, string | number>) => {
    try { (window as any).umami?.track(name, data); } catch {}
  };

  function message(saved: Saved): string {
    const lines = saved.items.map((i, k) => {
      const label = `${i.n}${i.b ? ` by ${i.b}` : ''}${i.z ? ` (${size(i.z)})` : ''}`;
      const qty = i.q > 1 ? ` x${i.q}` : '';
      const each = i.q > 1 ? ' each' : '';
      return `${k + 1}. ${label}${qty}: ${priceText(i)}${each}. Ref ${i.r}`;
    });
    const total = saved.items.reduce((sum, i) => sum + i.p * i.q, 0);
    const estimate = saved.items.some((i) => i.a !== 'in-store') ? 'About ' : '';
    const searches = [...new Set(saved.items.map((i) => i.sq?.trim()).filter(Boolean))];
    return [
      searches.length ? `(I searched for ${searches.map((q) => `"${q}"`).join(' and ')})` : '',
      'Hi Biba, I’d like to order these from your website:',
      '',
      ...lines,
      '',
      `Estimated total: ${estimate}${naira(total)}`,
      saved.city ? `Deliver to: ${saved.city}` : '',
      'Please confirm stock, the final total and delivery. Thank you!',
    ].filter((l, k, all) => l !== '' || (k > 0 && all[k - 1] !== '')).join('\n');
  }

  const inBag = (slug: string) => memory.items.some((i) => i.s === slug);

  // Every add button names its perfume with data-bag-slug. Tile buttons turn into a
  // tick that opens the bag; the product page button swaps its words.
  function syncButtons() {
    document.querySelectorAll<HTMLElement>('[data-bag-slug]').forEach((el) => {
      const isIn = inBag(el.dataset.bagSlug!);
      if (el.hasAttribute('aria-pressed')) {
        let name = '';
        try { name = JSON.parse(el.dataset.bagAdd || '{}').n || ''; } catch {}
        el.setAttribute('aria-pressed', String(isIn));
        el.setAttribute('aria-label', isIn ? `${name} is in your bag. View bag` : `Add ${name} to bag`);
      }
      const label = isIn ? el.dataset.labelIn : el.dataset.labelOut;
      if (label && el.textContent !== label) el.textContent = label;
    });
  }

  function render() {
    const saved = memory;
    const count = saved.items.reduce((n, i) => n + i.q, 0);
    syncButtons();
    document.querySelectorAll<HTMLElement>('[data-bag-count]').forEach((el) => {
      el.textContent = String(count);
      el.hidden = count === 0;
    });
    document.querySelectorAll<HTMLElement>('[data-bag-open-btn]').forEach((el) => {
      el.setAttribute('aria-label', count ? `Your order bag, ${count} item${count > 1 ? 's' : ''}` : 'Your order bag, empty');
    });
    ($('[data-bag-empty]', dialog) as HTMLElement).hidden = count > 0;
    ($('[data-bag-full]', dialog) as HTMLElement).hidden = count === 0;
    if (!count) return;

    list.innerHTML = saved.items.map((i) => `
      <li class="bag-item" data-s="${esc(i.s)}">
        <div class="bag-item-main">
          <a href="/p/${esc(i.s)}/">${esc(i.n)}</a>
          <p class="bag-quiet bag-small">${esc([i.b, size(i.z)].filter(Boolean).join(', '))} <span class="bag-tag">${tag[i.a]}</span></p>
          <p class="bag-price">${priceText(i)}</p>
        </div>
        <div class="bag-qty" role="group" aria-label="Quantity of ${esc(i.n)}">
          <button type="button" data-q="-1" aria-label="One less ${esc(i.n)}">−</button>
          <output aria-live="polite">${i.q}</output>
          <button type="button" data-q="1" aria-label="One more ${esc(i.n)}">+</button>
        </div>
        <button type="button" class="bag-link bag-remove" data-remove>Remove</button>
      </li>`).join('');

    const total = saved.items.reduce((sum, i) => sum + i.p * i.q, 0);
    const estimated = saved.items.some((i) => i.a !== 'in-store');
    $('[data-bag-total]', dialog).textContent = (estimated ? 'About ' : '') + naira(total);
    const orderIn = saved.items.filter((i) => i.a === 'order-in').length;
    const restock = saved.items.filter((i) => i.a === 'sold-before').length;
    const notes = [
      orderIn ? `${orderIn === 1 ? 'One item is' : `${orderIn} items are`} order-in, so Biba orders it in and confirms the price and timing.` : '',
      restock ? `${restock === 1 ? 'One item needs' : `${restock} items need`} a restock check.` : '',
    ].filter(Boolean).join(' ');
    $('[data-bag-note]', dialog).textContent = notes;
    if (document.activeElement !== city) city.value = saved.city;
    send.href = `https://wa.me/${wa}?text=${encodeURIComponent(message(saved))}`;
  }

  function add(raw: string, fromCity?: string) {
    let item: Item;
    try { item = { ...JSON.parse(raw), q: 1 }; } catch { return; }
    const saved = load();
    const found = saved.items.find((i) => i.s === item.s);
    if (found) {
      found.q = Math.min(found.q + 1, 20);
      if (item.sq) found.sq = item.sq;
    } else saved.items.push(item);
    // Adding from a city page fills in "Deliver to", but never replaces what the buyer typed
    if (fromCity && !saved.city) saved.city = fromCity;
    save({ ...saved });
    track('Bag add', { perfume: item.n, page: location.pathname });
    showToast(`${item.n} is in your bag.`);
  }

  function showToast(text: string) {
    $('[data-bag-toast-text]').textContent = text;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { toast.hidden = true; }, 4000);
  }

  function open() {
    toast.hidden = true;
    render();
    if (!dialog.open) dialog.showModal();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const adder = t.closest<HTMLElement>('[data-bag-add]');
    if (adder) {
      e.preventDefault();
      // Already in the bag: the button is a tick (or "View in bag"), so open the bag instead of adding another
      const slug = adder.dataset.bagSlug;
      load();
      if (slug && inBag(slug)) open();
      else add(adder.dataset.bagAdd!, adder.dataset.bagCity);
      return;
    }
    if (t.closest('[data-bag-open]')) { e.preventDefault(); open(); return; }
    if (t.closest('[data-bag-close]')) { dialog.close(); return; }
  });

  // Clicking the dimmed area outside the panel closes it
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  list.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const row = t.closest<HTMLElement>('[data-s]');
    if (!row) return;
    const saved = load();
    const i = saved.items.findIndex((x) => x.s === row.dataset.s);
    if (i < 0) return;
    const step = t.closest<HTMLElement>('[data-q]');
    if (step) {
      saved.items[i].q = Math.max(0, Math.min(20, saved.items[i].q + Number(step.dataset.q)));
      if (!saved.items[i].q) saved.items.splice(i, 1);
    } else if (t.closest('[data-remove]')) {
      saved.items.splice(i, 1);
    } else return;
    save({ ...saved });
  });

  city.addEventListener('input', () => save({ ...load(), city: city.value.trim() }));

  send.addEventListener('click', () => {
    const saved = load();
    track('Bag sent', { items: saved.items.length, units: saved.items.reduce((n, i) => n + i.q, 0) });
    ($('[data-bag-after]', dialog) as HTMLElement).hidden = false;
  });

  $('[data-bag-clear]', dialog).addEventListener('click', () => {
    save({ items: [], city: load().city });
    ($('[data-bag-after]', dialog) as HTMLElement).hidden = true;
  });

  // Search results are drawn after the page loads, and ask to be marked here
  document.addEventListener('bag:sync', syncButtons);

  // Keep in step with a bag changed in another tab
  window.addEventListener('storage', (e) => {
    if (e.key !== KEY && e.key !== null) return;
    try { memory = e.newValue ? JSON.parse(e.newValue) : { items: [], city: '' }; } catch { return; }
    render();
  });

  load();
  render();
</script>

<style is:global>
  .bag { margin: 0 0 0 auto; height: 100dvh; max-height: none; width: min(26rem, 100vw); max-width: none; padding: 0; border: 0; background: var(--ivory); color: var(--ink); box-shadow: -12px 0 40px rgba(21,17,14,.25); }
  .bag::backdrop { background: rgba(21,17,14,.45); }
  .bag[open] { animation: bag-in .35s cubic-bezier(.2,.7,.2,1); }
  @keyframes bag-in { from { transform: translateX(100%); } }
  @media (prefers-reduced-motion: reduce) { .bag[open] { animation: none; } }
  .bag-inner { display: flex; flex-direction: column; height: 100%; }
  .bag-head { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--line); }
  .bag-head h2 { font-size: 1.6rem; font-weight: 500; }
  .bag-close { width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; cursor: pointer; color: var(--ink); }
  .bag-close svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.5; fill: none; }
  .bag-empty { padding: 2rem 1.5rem; display: grid; gap: 0.75rem; justify-items: start; }
  .bag-empty[hidden], .bag-full[hidden], .bag-after[hidden] { display: none; }
  .bag-full { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .bag-list { list-style: none; margin: 0; padding: 0 1.5rem; overflow-y: auto; flex: 1; }
  .bag-item { display: grid; grid-template-columns: 1fr auto; gap: 0.4rem 1rem; padding-block: 1.1rem; border-bottom: 1px solid var(--line); }
  .bag-item-main a { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .bag-item-main a:hover { text-decoration: underline; text-decoration-color: var(--gold); }
  .bag-tag { display: inline-block; margin-left: 0.35rem; font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold-deep); }
  .bag-price { font-weight: 500; margin-top: 0.15rem; }
  .bag-qty { display: flex; align-items: center; border: 1px solid var(--line); align-self: center; }
  .bag-qty button { width: 44px; height: 44px; background: none; border: 0; font-size: 1.2rem; cursor: pointer; color: var(--ink); }
  .bag-qty output { min-width: 1.5rem; text-align: center; font-variant-numeric: lining-nums tabular-nums; }
  .bag-remove { grid-column: 1; justify-self: start; }
  .bag-summary { display: grid; gap: 0.8rem; padding: 1.25rem 1.5rem 1.5rem; border-top: 1px solid var(--line); background: var(--porcelain); }
  .bag-total { display: flex; justify-content: space-between; align-items: baseline; max-width: none; }
  .bag-total strong { font-size: 1.3rem; font-weight: 600; font-variant-numeric: lining-nums; }
  .bag-city { display: grid; gap: 0.35rem; font-size: 0.9rem; }
  .bag-city input { font: inherit; font-size: 1rem; padding: 0.75rem 0.9rem; border: 1px solid var(--line-strong, var(--line)); background: var(--ivory); color: var(--ink); min-height: 44px; }
  .bag-send { justify-content: center; }
  .bag-small { font-size: 0.85rem; }
  .bag-quiet { color: var(--ink-soft); }
  .bag-link { background: none; border: 0; padding: 0.6rem 0; min-height: 44px; font: inherit; font-size: 0.85rem; color: var(--ink); text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; cursor: pointer; }
  .bag-after { font-size: 0.9rem; }
  .bag-toast { position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%); z-index: 6; display: flex; align-items: center; gap: 1rem; padding: 0.4rem 0.6rem 0.4rem 1.1rem; background: var(--noir); color: var(--ivory); box-shadow: 0 10px 30px rgba(21,17,14,.35); max-width: calc(100vw - 2rem); font-size: 0.9rem; }
  .bag-toast .bag-link { color: var(--gold-light); }
  .bag-toast[hidden] { display: none; }
  .bag-toast .bag-link { white-space: nowrap; }
  @media (max-width: 40rem) { .bag-toast { left: 1rem; right: 5.25rem; transform: none; max-width: none; justify-content: space-between; } }
</style>
