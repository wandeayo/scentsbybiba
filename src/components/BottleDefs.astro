---
// One shared sprite of gradients and bottle shapes. Each bottle on the page is a
// <use> of a shape, tinted with --liq (the juice) and --cap (gold or black).
const liquids: Record<string, [string, string, string]> = {
  fresh: ['#f3efc4', '#dcdc98', '#b9c27a'],
  sweet: ['#f6d29c', '#e2a65e', '#b8753a'],
  floral: ['#f7d6d1', '#e8aaa6', '#c97f80'],
  fruity: ['#f9c0a4', '#ec8a6a', '#c4553f'],
  woody: ['#e2ad74', '#b9773f', '#7f4a22'],
  oud: ['#a8453b', '#6e2522', '#3a1214'],
  musky: ['#f6f1ec', '#e6dcd2', '#cbbcae'],
  // Bottle colours, used when a drawing follows the real bottle
  amber: ['#f2c27a', '#d48a35', '#9a5a1c'],
  honey: ['#f8e3a6', '#e9c060', '#c08f2e'],
  gold: ['#f6e3a8', '#d9b55e', '#9c7a32'],
  orange: ['#ffd29a', '#f39a3c', '#c4601a'],
  pink: ['#f9cfdc', '#ee93b1', '#c45c82'],
  blush: ['#f8e2dc', '#ecc0b8', '#d3958c'],
  red: ['#e9827a', '#b8312e', '#6e1416'],
  burgundy: ['#b2525a', '#741f2c', '#3e0c15'],
  navy: ['#5a6f9f', '#1f2f5c', '#0c1530'],
  blue: ['#9cc4ec', '#4d8bd0', '#21528f'],
  aqua: ['#c8f0ee', '#7fd2d0', '#3a9ea4'],
  green: ['#d6e6b4', '#9cbf6c', '#5f8a3c'],
  purple: ['#c9a8d8', '#8a5aa8', '#4e2a6a'],
  black: ['#5e5852', '#211c19', '#060504'],
  smoke: ['#d4d1cd', '#8d8984', '#4c4844'],
  white: ['#ffffff', '#f1ede7', '#d8d1c6'],
  clear: ['#fbf8ef', '#f1e9d2', '#ddd0ad'],
  brown: ['#b98a5c', '#7a4a26', '#40220e'],
  cream: ['#fbf1dc', '#f0dcb4', '#d6b98a'],
};
const metals: Record<string, string[]> = {
  silver: ['#7d7f83', '#eceef0', '#a9acb1', '#f8f9fa', '#808388'],
  rose: ['#9a5e4c', '#f1c6b3', '#c98d78', '#f8dccf', '#9d6250'],
  ivory: ['#cfc7b8', '#fffdf8', '#ebe5da', '#ffffff', '#cdc4b3'],
};
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    {Object.entries(liquids).map(([k, [a, b, c]]) => (
      <linearGradient id={`liq-${k}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={a} />
        <stop offset=".55" stop-color={b} />
        <stop offset="1" stop-color={c} />
      </linearGradient>
    ))}
    <linearGradient id="g-gold" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8c6a2e" />
      <stop offset=".22" stop-color="#e9d39c" />
      <stop offset=".45" stop-color="#c8a96a" />
      <stop offset=".7" stop-color="#f6e7bd" />
      <stop offset="1" stop-color="#94723a" />
    </linearGradient>
    {Object.entries(metals).map(([k, c]) => (
      <linearGradient id={`g-${k}`} x1="0" y1="0" x2="1" y2="0">
        {c.map((col, i) => <stop offset={[0, .22, .45, .7, 1][i]} stop-color={col} />)}
      </linearGradient>
    ))}
    <linearGradient id="g-noir" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#0d0a08" />
      <stop offset=".35" stop-color="#4a423b" />
      <stop offset=".6" stop-color="#1b1613" />
      <stop offset="1" stop-color="#050403" />
    </linearGradient>
    <linearGradient id="g-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity=".55" />
      <stop offset=".18" stop-color="#fff" stop-opacity=".12" />
      <stop offset=".8" stop-color="#fff" stop-opacity=".06" />
      <stop offset="1" stop-color="#fff" stop-opacity=".45" />
    </linearGradient>
    <linearGradient id="g-shine" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset=".5" stop-color="#fff" stop-opacity=".75" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="g-shadow" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#2a1d14" stop-opacity=".38" />
      <stop offset="1" stop-color="#2a1d14" stop-opacity="0" />
    </radialGradient>

    <clipPath id="cp-flacon"><path d="M18 96h84v92q0 16-16 16H34q-16 0-16-16z" /></clipPath>
    <clipPath id="cp-orb"><circle cx="60" cy="146" r="54" /></clipPath>
    <clipPath id="cp-oud"><path d="M60 72c38 0 44 42 44 78s-16 54-44 54-44-18-44-54 6-78 44-78z" /></clipPath>

    <!-- Faceted rectangle, the classic Arabian EDP bottle -->
    <symbol id="b-flacon" viewBox="0 0 120 220">
      <ellipse cx="60" cy="211" rx="50" ry="7" fill="url(#g-shadow)" />
      <path d="M40 6h40l7 10v36l-7 9H40l-7-9V16z" style="fill: var(--cap, url(#g-gold))" />
      <path d="M46 10h8v46h-8z" fill="#fff" opacity=".22" />
      <rect x="46" y="60" width="28" height="11" fill="url(#g-gold)" />
      <path d="M24 70h72l12 12v108q0 18-18 18H30q-18 0-18-18V82z" fill="#fff" fill-opacity=".35" stroke="#5b4a3a" stroke-opacity=".28" />
      <g clip-path="url(#cp-flacon)"><rect x="0" y="96" width="120" height="120" style="fill: var(--liq, url(#liq-sweet))" /></g>
      <path d="M24 70h72l12 12v108q0 18-18 18H30q-18 0-18-18V82z" fill="url(#g-glass)" />
      <path d="M22 86q-2 0-2 6v94q0 6 4 8V86z" fill="#fff" opacity=".65" />
      <rect x="34" y="128" width="52" height="34" rx="1.5" fill="#fbf7f0" fill-opacity=".92" stroke="#c8a96a" stroke-width="1.2" />
      <path d="M44 140h32M48 148h24" stroke="#8c6a2e" stroke-width="1.4" stroke-linecap="round" opacity=".7" />
    </symbol>

    <!-- Round flacon with a tall cap -->
    <symbol id="b-orb" viewBox="0 0 120 220">
      <ellipse cx="60" cy="211" rx="48" ry="7" fill="url(#g-shadow)" />
      <rect x="48" y="4" width="24" height="64" rx="5" style="fill: var(--cap, url(#g-gold))" />
      <rect x="52" y="8" width="5" height="56" rx="2" fill="#fff" opacity=".25" />
      <rect x="44" y="68" width="32" height="12" rx="2" fill="url(#g-gold)" />
      <circle cx="60" cy="146" r="58" fill="#fff" fill-opacity=".35" stroke="#5b4a3a" stroke-opacity=".28" />
      <g clip-path="url(#cp-orb)"><rect x="0" y="112" width="120" height="100" style="fill: var(--liq, url(#liq-floral))" /></g>
      <circle cx="60" cy="146" r="58" fill="url(#g-glass)" />
      <path d="M22 118q8-22 30-30" stroke="#fff" stroke-width="5" stroke-linecap="round" fill="none" opacity=".7" />
      <ellipse cx="60" cy="152" rx="22" ry="14" fill="#fbf7f0" fill-opacity=".9" stroke="#c8a96a" stroke-width="1.2" />
      <path d="M50 152h20" stroke="#8c6a2e" stroke-width="1.4" stroke-linecap="round" opacity=".7" />
    </symbol>

    <!-- Tall column with a sphere cap, the designer silhouette -->
    <symbol id="b-column" viewBox="0 0 120 220">
      <ellipse cx="60" cy="211" rx="40" ry="6" fill="url(#g-shadow)" />
      <circle cx="60" cy="28" r="22" style="fill: var(--cap, url(#g-noir))" />
      <ellipse cx="52" cy="20" rx="6" ry="9" fill="#fff" opacity=".28" />
      <rect x="48" y="48" width="24" height="10" fill="url(#g-gold)" />
      <rect x="28" y="58" width="64" height="150" rx="10" fill="#fff" fill-opacity=".35" stroke="#5b4a3a" stroke-opacity=".28" />
      <rect x="32" y="84" width="56" height="120" rx="7" style="fill: var(--liq, url(#liq-woody))" />
      <rect x="28" y="58" width="64" height="150" rx="10" fill="url(#g-glass)" />
      <rect x="33" y="64" width="5" height="138" rx="2.5" fill="#fff" opacity=".6" />
      <rect x="40" y="132" width="40" height="44" fill="#fbf7f0" fill-opacity=".92" stroke="#c8a96a" stroke-width="1.2" />
      <path d="M48 146h24M51 154h18M54 162h12" stroke="#8c6a2e" stroke-width="1.3" stroke-linecap="round" opacity=".7" />
    </symbol>

    <!-- Arabian oud bottle with a domed spire -->
    <symbol id="b-oud" viewBox="0 0 120 220">
      <ellipse cx="60" cy="211" rx="48" ry="7" fill="url(#g-shadow)" />
      <path d="M60 0l5 12q12 6 12 22 0 14-17 22-17-8-17-22 0-16 12-22z" style="fill: var(--cap, url(#g-gold))" />
      <path d="M55 16q-6 6-5 18" stroke="#fff" stroke-width="2.5" fill="none" opacity=".4" stroke-linecap="round" />
      <rect x="46" y="56" width="28" height="9" fill="url(#g-gold)" />
      <path d="M50 65h20v6H50z" fill="url(#g-gold)" opacity=".8" />
      <path d="M60 72c38 0 44 42 44 78s-16 54-44 54-44-18-44-54 6-78 44-78z" fill="#fff" fill-opacity=".35" stroke="#5b4a3a" stroke-opacity=".28" />
      <g clip-path="url(#cp-oud)"><rect x="0" y="100" width="120" height="110" style="fill: var(--liq, url(#liq-oud))" /></g>
      <path d="M60 72c38 0 44 42 44 78s-16 54-44 54-44-18-44-54 6-78 44-78z" fill="url(#g-glass)" />
      <path d="M18 132c4-24 16-44 34-52" stroke="#fff" stroke-width="4" fill="none" opacity=".6" stroke-linecap="round" />
      <path d="M17 120h86M15 178h90" stroke="url(#g-gold)" stroke-width="3" />
      <path d="M60 134l12 14-12 14-12-14z" fill="#fbf7f0" fill-opacity=".9" stroke="#c8a96a" stroke-width="1.2" />
    </symbol>

    <!-- Mini, oil or travel size -->
    <symbol id="b-mini" viewBox="0 0 120 220">
      <ellipse cx="60" cy="211" rx="30" ry="5" fill="url(#g-shadow)" />
      <rect x="44" y="88" width="32" height="40" rx="4" style="fill: var(--cap, url(#g-gold))" />
      <rect x="48" y="92" width="5" height="32" rx="2" fill="#fff" opacity=".3" />
      <rect x="47" y="128" width="26" height="6" fill="url(#g-gold)" />
      <rect x="38" y="134" width="44" height="74" rx="8" fill="#fff" fill-opacity=".35" stroke="#5b4a3a" stroke-opacity=".28" />
      <rect x="41" y="146" width="38" height="59" rx="6" style="fill: var(--liq, url(#liq-musky))" />
      <rect x="38" y="134" width="44" height="74" rx="8" fill="url(#g-glass)" />
      <rect x="42" y="139" width="4" height="64" rx="2" fill="#fff" opacity=".6" />
      <rect x="47" y="166" width="26" height="18" fill="#fbf7f0" fill-opacity=".92" stroke="#c8a96a" stroke-width="1" />
    </symbol>

    <!-- Wide rectangular slab with a square cap -->
    <symbol id="b-block" viewBox="0 0 120 220">
      <ellipse cx="60" cy="212" rx="54" ry="7" fill="url(#g-shadow)" />
      <rect x="38" y="20" width="44" height="48" rx="3" style="fill: var(--cap, url(#g-noir))" />
      <rect x="43" y="24" width="7" height="40" rx="2" fill="#fff" opacity=".22" />
      <rect x="46" y="68" width="28" height="10" fill="url(#g-gold)" />
      <rect x="10" y="78" width="100" height="130" rx="9" fill="#fff" fill-opacity=".35" stroke="#5b4a3a" stroke-opacity=".28" />
      <rect x="14" y="86" width="92" height="118" rx="6" style="fill: var(--liq, url(#liq-woody))" />
      <rect x="10" y="78" width="100" height="130" rx="9" fill="url(#g-glass)" />
      <rect x="15" y="84" width="5" height="118" rx="2.5" fill="#fff" opacity=".5" />
      <rect x="34" y="124" width="52" height="40" fill="#fbf7f0" fill-opacity=".9" stroke="#c8a96a" stroke-width="1.2" />
      <path d="M44 138h32M48 147h24" stroke="#8c6a2e" stroke-width="1.4" stroke-linecap="round" opacity=".7" />
    </symbol>

    <!-- Round flat bottle with a medallion -->
    <symbol id="b-disc" viewBox="0 0 120 220">
      <ellipse cx="60" cy="210" rx="46" ry="7" fill="url(#g-shadow)" />
      <circle cx="60" cy="22" r="15" style="fill: var(--cap, url(#g-gold))" />
      <rect x="50" y="34" width="20" height="30" rx="3" style="fill: var(--cap, url(#g-gold))" />
      <rect x="54" y="38" width="4" height="22" rx="2" fill="#fff" opacity=".3" />
      <rect x="46" y="64" width="28" height="9" fill="url(#g-gold)" />
      <rect x="52" y="73" width="16" height="20" fill="url(#g-gold)" opacity=".85" />
      <circle cx="60" cy="146" r="56" style="fill: var(--liq, url(#liq-sweet))" stroke="#5b4a3a" stroke-opacity=".25" />
      <circle cx="60" cy="146" r="56" fill="url(#g-glass)" />
      <circle cx="60" cy="146" r="41" fill="none" stroke="url(#g-gold)" stroke-width="3" />
      <path d="M60 128l12 18-12 18-12-18z" fill="url(#g-gold)" />
      <path d="M18 122q8-24 32-34" stroke="#fff" stroke-width="5" stroke-linecap="round" fill="none" opacity=".55" />
    </symbol>

    <!-- Tall cylinder with a deep cap and a crossed band -->
    <symbol id="b-tall" viewBox="0 0 120 220">
      <ellipse cx="60" cy="212" rx="38" ry="6" fill="url(#g-shadow)" />
      <rect x="30" y="4" width="60" height="58" rx="6" style="fill: var(--cap, url(#g-gold))" />
      <rect x="30" y="4" width="60" height="58" rx="6" fill="url(#g-glass)" />
      <rect x="28" y="60" width="64" height="7" fill="url(#g-gold)" />
      <rect x="30" y="67" width="60" height="141" rx="8" style="fill: var(--liq, url(#liq-sweet))" stroke="#5b4a3a" stroke-opacity=".25" />
      <rect x="30" y="67" width="60" height="141" rx="8" fill="url(#g-glass)" />
      <rect x="35" y="72" width="5" height="130" rx="2.5" fill="#fff" opacity=".45" />
      <path d="M26 112q34 14 68 0v10q-34 14-68 0zM26 142q34-14 68 0v-10q-34-14-68 0z" fill="url(#g-gold)" />
      <circle cx="60" cy="127" r="10" fill="#fbf7f0" stroke="url(#g-gold)" stroke-width="3" />
    </symbol>
  </defs>
</svg>
