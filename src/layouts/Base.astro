---
import '../styles/global.css';
import { SITE, waLink } from '../lib/site';
import WaIcon from '../components/WaIcon.astro';
import BottleDefs from '../components/BottleDefs.astro';
import Bag from '../components/Bag.astro';
import { CITIES } from '../lib/cities';
import { existsSync } from 'node:fs';
interface Props { title: string; description: string; jsonLd?: object; image?: string; imageAlt?: string }
const { title, description, jsonLd } = Astro.props;
// Link previews (WhatsApp, Instagram, X). Product pages pass their own card; every
// other page uses the shop card drawn by src/pages/og/home.jpg.ts. A 1200x630 image
// dropped at public/og.jpg (a real shop photo, say) overrides that card.
const defaultImage = ['og.jpg', 'og.png'].find((f) => existsSync(`public/${f}`));
const image = Astro.props.image ?? (defaultImage ? `/${defaultImage}` : '/og/home.jpg');
const imageAlt = Astro.props.imageAlt ?? 'Scents by Biba, fine perfumes in Jos';
// Set these in Vercel > Settings > Environment Variables. Nothing is added until they exist.
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const fullTitle = title === SITE.name ? `${SITE.name} | Fine perfumes in Jos, delivered across Nigeria` : `${title} | ${SITE.name}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/shop/', label: 'The collection' },
  { href: '/smells-like/', label: 'Smells like' },
  { href: '/story/', label: 'Our story' },
  { href: '/visit/', label: 'Visit & delivery' },
];
const canonical = new URL(path, SITE.url).href;
const imageUrl = image && new URL(image, SITE.url).href;
const helpMsg = 'Hi Biba, I’m on your website and I’d like some help choosing a perfume.';
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#15110e" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_NG" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && image?.startsWith('/og/') && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    {imageUrl && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {umamiId && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiId} data-domains={new URL(SITE.url).hostname}></script>}
    {umamiId && (
      <script is:inline>
        // Every WhatsApp tap is a lead. Record where it happened and, on product buttons, which perfume.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="https://wa.me/"]');
          if (!a || !window.umami) return;
          var data = { spot: a.dataset.wa || 'other', page: location.pathname };
          if (a.dataset.perfume) data.perfume = a.dataset.perfume;
          window.umami.track('WhatsApp click', data);
        });
      </script>
    )}
  </head>
  <body>
    <BottleDefs />
    <a class="skip" href="#main">Skip to content</a>
    <div class="topbar">
      <p>{SITE.delivery}</p>
      <p class="hide-sm">{SITE.addressShort}, open Monday to Saturday</p>
    </div>
    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label="Scents by Biba, home">
          <span class="wm-main">Scents</span>
          <span class="wm-sub">by Biba</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="header-actions">
          <a class="header-wa" href={waLink(helpMsg)} target="_blank" rel="noopener" data-wa="header"><WaIcon /><span>Chat with Biba</span></a>
          <button type="button" class="bag-btn" data-bag-open data-bag-open-btn aria-label="Your order bag, empty">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2L5 8Z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" /></svg>
            <span class="bag-count" data-bag-count hidden>0</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-brand">
          <a class="wordmark" href="/"><span class="wm-main">Scents</span><span class="wm-sub">by Biba</span></a>
          <p class="italic">Fine fragrance in Jos since 2020.</p>
        </div>
        <div class="foot">
          <div>
            <h2>The boutique</h2>
            <p>{SITE.address}</p>
            <p>{SITE.hours}</p>
            <p><a class="link" href={SITE.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a></p>
          </div>
          <div>
            <h2>Order</h2>
            <p><a class="link" href={waLink('Hi Biba, I’d like to place an order.')} target="_blank" rel="noopener" data-wa="footer">WhatsApp {SITE.phoneDisplay}</a></p>
            <p>{SITE.delivery}</p>
            <p>We deliver to {CITIES.map((c, i) => <>{i > 0 && ', '}<a class="link" href={`/delivery/${c.slug}/`}>{c.name}</a></>)} and the rest of Nigeria.</p>
          </div>
          <div>
            <h2>Follow</h2>
            <p><a class="link" href={SITE.instagram} target="_blank" rel="noopener">Instagram @scentsbybiba_</a></p>
          </div>
        </div>
        <p class="fineprint">“Smells like” comparisons describe a scent’s style only. Scents by Biba is not linked to those brands, and inspired perfumes are not the original products. Prices marked “About” are for perfumes we order in for you; Biba confirms the final price on WhatsApp before you pay.</p>
      </div>
    </footer>
    <Bag />
    <a class="float-wa" href={waLink(helpMsg)} target="_blank" rel="noopener" data-wa="floating" aria-label="Chat with Biba on WhatsApp"><WaIcon /></a>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; background: var(--porcelain); padding: 0.5rem 1rem; z-index: 10; }
  .skip:focus { left: 0.5rem; top: 0.5rem; }
  .topbar { background: var(--noir); color: var(--gold-light); display: flex; justify-content: center; gap: 2.5rem; padding: 0.55rem 1rem; font-size: 0.78rem; letter-spacing: 0.05em; text-align: center; }
  .topbar p { max-width: none; }
  @media (max-width: 40rem) { .hide-sm { display: none; } }
  .site-header { background: var(--ivory); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 4; }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.5rem 1.5rem; padding-block: 1rem; }
  .wordmark { grid-column: 2; display: grid; justify-items: center; text-decoration: none; color: var(--ink); line-height: 1; }
  .wm-main { font-family: var(--serif); font-weight: 500; font-size: 2rem; letter-spacing: 0.32em; text-transform: uppercase; margin-right: -0.32em; }
  .wm-sub { font-family: var(--serif); font-style: italic; font-size: 1rem; color: var(--gold-deep); margin-top: 0.1rem; }
  nav { grid-column: 1 / -1; grid-row: 2; }
  nav ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.1rem clamp(1rem, 3vw, 2.5rem); margin: 0; padding: 0; white-space: nowrap; }
  nav a { font-size: 0.85rem; letter-spacing: 0.05em; text-decoration: none; color: var(--ink-soft); padding-block: 0.35rem; display: inline-block; border-bottom: 1px solid transparent; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--gold); }
  .header-actions { grid-column: 3; grid-row: 1; justify-self: end; display: flex; align-items: center; gap: 1rem; }
  .bag-btn { position: relative; width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; cursor: pointer; color: var(--ink); }
  .bag-btn svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; }
  .bag-count { position: absolute; top: 4px; right: 2px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 9px; background: var(--gold-deep); color: var(--ivory); font-size: 0.7rem; font-weight: 600; display: grid; place-items: center; font-variant-numeric: lining-nums; }
  .bag-count[hidden] { display: none; }
  .header-wa { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; letter-spacing: 0.04em; text-decoration: none; color: var(--ink); }
  .header-wa :global(svg) { width: 18px; height: 18px; fill: var(--gold-deep); }
  .header-wa:hover span { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; }
  @media (max-width: 40rem) {
    .header-wa span { display: none; }
    .header-wa { width: 44px; height: 44px; justify-content: center; }
    .header-actions { gap: 0.25rem; }
    .wm-main { font-size: 1.6rem; }
  }
  .float-wa { position: fixed; right: 1rem; bottom: 1rem; z-index: 5; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--noir); color: var(--gold-light); box-shadow: 0 8px 24px rgba(21,17,14,.35); }
  .float-wa :global(svg) { width: 26px; height: 26px; fill: currentColor; }
  @media (min-width: 40.01rem) { .float-wa { display: none; } }
  .site-footer { background: var(--noir); color: rgba(247,242,234,.82); padding-block: 4rem 6rem; margin-top: 3rem; }
  .site-footer .wordmark { color: var(--ivory); justify-items: start; }
  .site-footer .wm-sub { color: var(--gold-light); }
  .foot-brand { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .foot-brand .italic { font-size: 1.2rem; color: var(--gold-light); }
  .foot { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); padding-block: 2rem; border-block: 1px solid rgba(227,205,155,.25); }
  .foot h2 { font-size: 1.3rem; color: var(--ivory); margin-bottom: 0.6rem; }
  .foot p { margin-bottom: 0.35rem; font-size: 0.92rem; }
  .fineprint { margin-top: 2rem; font-size: 0.78rem; color: rgba(247,242,234,.5); max-width: 75ch; }
</style>
